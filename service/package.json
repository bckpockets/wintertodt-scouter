{
  "name": "wintertodt-scouter-service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test",
    "start": "node server.mjs",
    "dev:worker": "wrangler dev --local",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "test:worker-runtime": "node smoke-worker.mjs",
    "deploy:worker": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.151.0" }
}
